---
const nav = [
  { href: '/projects', label: 'Projects' },
  { href: '/blogs', label: 'Blogs' },
  { href: '/readings', label: 'Readings' },
  { href: '/misc', label: 'Misc' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="sticky top-0 z-20 border-b border-white/5 bg-cream/80 backdrop-blur-md">
  <nav
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-y-3 px-6 py-4 sm:py-5"
  >
    <a
      href="/"
      class="font-serif text-xl font-semibold tracking-tight text-ink transition-opacity hover:opacity-70 sm:text-2xl"
      aria-current={currentPath === '/' ? 'page' : undefined}
    >
      Shawn Han
    </a>

    <div
      class="flex w-full items-center justify-center gap-6 sm:w-auto sm:justify-end sm:gap-9"
    >
      {
        nav.map(({ href, label }) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class={`text-[11px] uppercase tracking-[0.12em] transition-colors sm:text-xs md:text-sm ${
              isActive(href)
                ? 'font-medium text-ink'
                : 'text-soft-ink hover:text-ink'
            }`}
          >
            {label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
