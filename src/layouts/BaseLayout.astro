---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SocialIcons from '../components/SocialIcons.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  coverImageUrl?: string;
  coverImageWidth?: number;
  coverImageHeight?: number;
  showSocialSidebar?: boolean;
  hideFooter?: boolean;
  fullScreen?: boolean;
  mainClass?: string;
}

const { title, description, coverImageUrl, coverImageWidth, coverImageHeight, showSocialSidebar, hideFooter, fullScreen, mainClass = '' } = Astro.props;
const baseUrl = Astro.site || Astro.url?.origin;

// Match the actual optimized file extension so og:image:type is not wrong.
const coverExt = coverImageUrl?.split('?')[0].split('.').pop()?.toLowerCase();
const coverMimeTypes: Record<string, string> = {
  png: 'image/png',
  jpg: 'image/jpeg',
  jpeg: 'image/jpeg',
  webp: 'image/webp',
  avif: 'image/avif',
  gif: 'image/gif',
  svg: 'image/svg+xml',
};
const coverImageType = coverExt ? coverMimeTypes[coverExt] ?? 'image/png' : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0e1410" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap" rel="stylesheet" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <!-- Open Graph / Social share -->
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="article" />
    {coverImageUrl && baseUrl && (
      <>
        <meta property="og:image" content={new URL(coverImageUrl, baseUrl).href} />
        {coverImageWidth && <meta property="og:image:width" content={String(coverImageWidth)} />}
        {coverImageHeight && <meta property="og:image:height" content={String(coverImageHeight)} />}
        {coverImageType && <meta property="og:image:type" content={coverImageType} />}
      </>
    )}
    <meta name="twitter:card" content={coverImageUrl ? "summary_large_image" : "summary"} />

  </head>
  <body class={`${fullScreen ? 'h-screen overflow-hidden' : 'min-h-screen'} flex flex-col`}>
    <Header />
    {
      showSocialSidebar && (
        <div class="hidden lg:flex fixed flex-col gap-8 z-10" style="left: max(0.5rem, calc((100vw - 48rem) / 2 - 7rem)); top: 40%; transform: translateY(-50%);">
          <SocialIcons layout="vertical" />
        </div>
      )
    }
    <main class={`flex-1 w-full ${mainClass || 'max-w-3xl mx-auto px-6 py-12'}`}>
      <slot />
    </main>
    {!hideFooter && <Footer />}
  </body>
</html>
