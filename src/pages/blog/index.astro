---
const target = '/blogs/';
const canonical = new URL(target, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical} />
    <title>Blogs — Shawn Han</title>
    <style>
      body {
        background: #0e1410;
        color: #f2efe7;
        font-family: ui-sans-serif, system-ui, sans-serif;
        display: grid;
        min-height: 100vh;
        place-items: center;
      }
      a { color: #8ab4ff; }
    </style>
  </head>
  <body>
    <p>Redirecting to <a href={target}>Blogs</a>…</p>
  </body>
</html>
