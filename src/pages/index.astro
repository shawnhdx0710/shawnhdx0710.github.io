---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcons from '../components/SocialIcons.astro';
import FootballBackground from '../components/FootballBackground.astro';
---

<BaseLayout
  title="Shawn Han"
  description="Shawn Han (韩德轩) — statistics, machine learning, and artificial intelligence at Carnegie Mellon University."
  hideFooter={true}
  mainClass="relative flex flex-1 items-center justify-center px-6 py-20"
>
  <FootballBackground />

  <div class="home-copy relative z-10 w-full max-w-2xl text-left">
    <div class="home-glow" aria-hidden="true"></div>

    <h1 class="sr-only">Shawn Han</h1>

    <div class="home-intro relative z-10">
      <p>
        Hi, I'm Shawn Han (韩德轩), a freshman studying statistics, machine learning, and
        artificial intelligence at Carnegie Mellon University.
      </p>
      <p>
        Born and raised in Shanghai, I'm a massive sports enthusiast who loves playing
        soccer and basketball—and nerding out over the analytics behind them. Outside of
        sports and academics, you can find me collecting jerseys and 1:64 car models,
        experimenting in the kitchen, diving into the humanities, or simply taking time to
        ponder.
      </p>
      <p>Thank you for stopping by my little peaceful corner of the web! :]</p>
    </div>

    <div class="relative z-10 mt-10 flex justify-start">
      <SocialIcons layout="horizontal" />
    </div>
  </div>
</BaseLayout>

<style>
  .home-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 0;
    width: min(56rem, 100vw);
    height: 32rem;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      closest-side,
      rgba(14, 20, 16, 0.95),
      rgba(14, 20, 16, 0.72) 55%,
      rgba(14, 20, 16, 0) 100%
    );
    filter: blur(20px);
    pointer-events: none;
  }

  .home-intro {
    max-width: 42rem;
    font-size: clamp(1.02rem, 1.6vw, 1.18rem);
    font-weight: 500;
    line-height: 1.9;
    color: var(--color-ink);
    text-wrap: pretty;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 0.75);
  }

  .home-intro p + p {
    margin-top: 1.2em;
  }

  @media (max-width: 640px) {
    .home-glow {
      width: 100vw;
      height: 26rem;
      filter: blur(14px);
    }

    .home-intro {
      font-size: 1rem;
      line-height: 1.85;
    }
  }
</style>
